# =============================================================================
# services/matcher — Environment variables
# =============================================================================

PORT=3003
NODE_ENV=development

DATABASE_URL=postgres://arcex:password@localhost:5432/arcex

ARC_RPC_HTTP=https://rpc.testnet.arc.io
CHAIN_ID=5042002

# Matcher hot-wallet private key — signs settlement txns.
# IMPORTANT: Fund this wallet with USDC for gas. Keep it separate from admin.
MATCHER_PRIVATE_KEY=0xPASTE_MATCHER_KEY_HERE

# Settlement contract address (Phase 3)
ORDER_SETTLEMENT_ADDRESS=

# Batch submission settings
BATCH_MAX_MATCHES=50
BATCH_INTERVAL_MS=500
# Max gas price willing to pay for settlement (gwei — Arc floor is 20)
MAX_GAS_PRICE_GWEI=100

# WS gateway for depth/trades publishing
WS_GATEWAY_URL=http://localhost:3002
WS_GATEWAY_TOKEN=changeme

# Self-trade prevention: "cancel_maker" | "cancel_taker" | "cancel_both"
SELF_TRADE_PREVENTION=cancel_taker
