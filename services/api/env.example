# =============================================================================
# services/api — Environment variables
# =============================================================================

PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgres://arcex:password@localhost:5432/arcex

# Arc RPC (for multicall balance reads)
ARC_RPC_HTTP=https://rpc.testnet.arc.io
CHAIN_ID=5042002

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# WS gateway connection (this service embeds the WS gateway)
WS_PORT=3002
WS_HEARTBEAT_INTERVAL_MS=30000

# Internal auth token for indexer -> gateway publishes
WS_GATEWAY_TOKEN=changeme

# Contract addresses (for portfolio multicall)
SPOT_POOL_ADDRESS=
PERP_ENGINE_ADDRESS=
MARKET_REGISTRY_ADDRESS=
