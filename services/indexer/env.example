# =============================================================================
# services/indexer — Environment variables
# Copy to .env and fill in.  NEVER commit .env.
# =============================================================================

# Arc RPC (HTTP) — used for eth_getLogs backfill and block polling
ARC_RPC_HTTP=https://rpc.testnet.arc.io
# Arc RPC (WebSocket) — used for real-time log subscriptions
ARC_RPC_WS=wss://rpc.testnet.arc.io

# Chain ID (5042 = mainnet, 5042002 = testnet)
CHAIN_ID=5042002

# Database connection string (Timescale/Postgres)
DATABASE_URL=postgres://arcex:password@localhost:5432/arcex

# Contracts to index (populated after deploy)
SPOT_POOL_ADDRESS=
PERP_ENGINE_ADDRESS=
MARKET_REGISTRY_ADDRESS=

# How far back to backfill on first run (block number or "latest")
BACKFILL_FROM_BLOCK=latest

# Block checkpoint flush interval (ms)
CHECKPOINT_INTERVAL_MS=5000

# WS pub-sub gateway URL (indexer publishes parsed events here)
WS_GATEWAY_URL=http://localhost:3002
WS_GATEWAY_TOKEN=changeme
