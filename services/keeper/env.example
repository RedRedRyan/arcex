# =============================================================================
# services/keeper — Environment variables
# =============================================================================

PORT=3004
NODE_ENV=development

ARC_RPC_HTTP=https://rpc.testnet.arc.io
CHAIN_ID=5042002
DATABASE_URL=postgres://arcex:password@localhost:5432/arcex

# Keeper hot-wallet private key — calls liquidate(), pokeFunding(), updateTwap().
# Must hold USDC for gas. Separate from matcher and admin wallets.
KEEPER_PRIVATE_KEY=0xPASTE_KEEPER_KEY_HERE

# Contract addresses
PERP_ENGINE_ADDRESS=
ORACLE_ROUTER_ADDRESS=
INSURANCE_FUND_ADDRESS=

# Liquidation scanner interval (ms)
LIQUIDATION_SCAN_INTERVAL_MS=2000
# Funding poke interval (ms) — must align with contract's fundingInterval
FUNDING_POKE_INTERVAL_MS=3600000
# TWAP update interval (ms)
TWAP_UPDATE_INTERVAL_MS=60000

# Health alert webhook (Slack / PagerDuty incoming webhook URL)
HEALTH_ALERT_WEBHOOK=

# Max gas price for keeper txns (gwei — Arc floor is 20)
MAX_GAS_PRICE_GWEI=100
