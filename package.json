{
  "name": "arcex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "services/indexer",
    "services/api",
    "services/matcher",
    "services/keeper"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "indexer": "bun run --cwd services/indexer start",
    "indexer:dev": "bun run --cwd services/indexer dev",
    "deploy:self": "tsx ./scripts/self-deploy.ts",
    "compass:deploy": "tsx ./scripts/compass-deploy.ts",
    "fetch:abi": "tsx ./scripts/fetch-abi.ts",
    "seed:pools": "tsx ./scripts/seed-pools.ts",
    "lint": "oxlint --type-aware src scripts --fix; s=$?; oxlint --fix .; exit $((s>0?s:$?))",
    "typecheck": "tsc --noEmit",
    "check": "bash /home/user/arc-studio-helpers/check.sh",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "test": "bun run --cwd packages/shared test",
    "deploy:testnet": "forge script contracts/script/DeployV2.s.sol --rpc-url arc_testnet --broadcast --slow -vvvv",
    "deploy:mainnet": "forge script contracts/script/DeployMainnet.s.sol --rpc-url arc_mainnet --broadcast --slow -vvvv"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@circle-fin/adapter-viem-v2": "^1.18.0",
    "@circle-fin/app-kit": "^1.15.2",
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@circle-fin/modular-wallets-core": "^1.0.16",
    "@circle-fin/smart-contract-platform": "^10.8.0",
    "@circle-fin/user-controlled-wallets": "^10.8.0",
    "@circle-fin/w3s-pw-web-sdk": "^1.1.11",
    "@dynamic-labs/ethereum": "^5.9.6",
    "@dynamic-labs/sdk-react-core": "^5.9.6",
    "@dynamic-labs/wagmi-connector": "^5.9.6",
    "@gsap/react": "^2.1.2",
    "@openzeppelin/contracts": "5.1.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.62.7",
    "@vercel/analytics": "^2.0.1",
    "@web3icons/react": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "connectkit": "^1.9.2",
    "framer-motion": "^11.15.0",
    "gsap": "^3.15.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.468.0",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-responsive": "^10.0.1",
    "react-router-dom": "^7.18.4",
    "recharts": "3.8.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "viem": "^2.56.3",
    "wagmi": "^2.19.5",
    "zod": "^3.23.8"
  },
  "overrides": {
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~7.0.2",
    "vite": "^6.0.5",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vitest": "^2.0.0"
  }
}
