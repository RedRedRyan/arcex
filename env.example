# =============================================================================
# arcex — Root environment variables
# Copy to .env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Arc RPC endpoints
# -----------------------------------------------------------------------------
ARC_MAINNET_RPC=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC=https://rpc.testnet.arc.io

# -----------------------------------------------------------------------------
# Deployment — required for forge script
# IMPORTANT: On mainnet the deployer key is for gas/signing ONLY.
# Admin ownership must go to a multisig (ADMIN_ADDRESS below), never the deployer.
# -----------------------------------------------------------------------------
ARC_PRIVATE_KEY=0xPASTE_YOUR_PRIVATE_KEY_HERE

# Multisig address that owns the Timelock + protocol contracts.
# Must be 0x3B2f9f644312cdB69be095FCC3b353C69a0088B2 or another Safe/multisig.
# NEVER set to an EOA on mainnet.
ADMIN_ADDRESS=0x3B2f9f644312cdB69be095FCC3b353C69a0088B2

# Timelock delay in seconds.
# Testnet: 3600 (1 hour) is fine.
# Mainnet: minimum 86400 (24 hours). Script enforces this.
TIMELOCK_DELAY_SECONDS=86400

# Mainnet deploy gate — must be exactly "yes" to run DeployMainnet.s.sol.
# Leave blank for testnet deploys.
MAINNET_CONFIRM=

# -----------------------------------------------------------------------------
# USDC address (canonical on all Arc chains)
# -----------------------------------------------------------------------------
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# -----------------------------------------------------------------------------
# Phase 0 contract addresses — populated after running DeployV2.s.sol
# Prefix VITE_ exposes the value to the React frontend at build time.
# Both a VITE_ and a bare copy are provided so Foundry scripts can use the bare name.
# -----------------------------------------------------------------------------

# Testnet
VITE_TIMELOCK_ADDRESS=
VITE_MARKET_REGISTRY_ADDRESS=
VITE_SPOT_POOL_ADDRESS=0x0ff9a151D9BE48d9222f9C680Ce4052E7c1f7b98
VITE_PERP_ENGINE_ADDRESS=0xbF6Ea775808485A19282C662A00Dbbbcae756D2B
# Dynamic wallet SDK — get your env ID at https://app.dynamic.xyz/dashboard/developer/api
VITE_DYNAMIC_ENV_ID=your_dynamic_environment_id_here

VITE_PRICE_ORACLE_ADDRESS=0xcE0062be693EefF4e021bb7a8014A0d30C47dF0a
VITE_TECHX_ADDRESS=0xCA70737705C71094827555a9b0015E05308F1326
VITE_ENERGYX_ADDRESS=0xd463C6424c2776495A6EA88F575693D1fadcC5E6
VITE_ARCX_ADDRESS=0x5642aC5570d6ee46D1ff86D499D0009370Fd0CAF

TIMELOCK_ADDRESS=
MARKET_REGISTRY_ADDRESS=
SPOT_POOL_ADDRESS=0x0ff9a151D9BE48d9222f9C680Ce4052E7c1f7b98
PERP_ENGINE_ADDRESS=0xbF6Ea775808485A19282C662A00Dbbbcae756D2B
PRICE_ORACLE_ADDRESS=0xcE0062be693EefF4e021bb7a8014A0d30C47dF0a
TECHX_ADDRESS=0xCA70737705C71094827555a9b0015E05308F1326
ENERGYX_ADDRESS=0xd463C6424c2776495A6EA88F575693D1fadcC5E6
ARCX_ADDRESS=0x5642aC5570d6ee46D1ff86D499D0009370Fd0CAF

# Pool seeding amounts (USDC, 6 decimals). Ratio: usdcAmt / baseAmt = oracle price.
SEED_USDC_TECHX=15000000000
SEED_USDC_ENERGYX=7500000000
SEED_USDC_ARCX=2500000000
SKIP_SEED=false

# Oracle seed prices (8-decimal fixed point)
PRICE_TECHX=15000000000
PRICE_ENERGYX=7500000000
PRICE_ARCX=2500000000

# Blockscout verification — Blockscout ignores the key value; set to "any"
ETHERSCAN_API_KEY=any

# -----------------------------------------------------------------------------
# Circle / Arc Studio credentials (optional — Circle SDK flows only)
# -----------------------------------------------------------------------------
# CIRCLE_DEVELOPER_CONTROLLED_API_KEY=
# CIRCLE_ENTITY_SECRET=
