# =============================================================================
# stockX Pro — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is listed in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment — required for `forge script` deploys
# -----------------------------------------------------------------------------

# Your deployer wallet private key (0x-prefixed). Keep this file private after filling it.
# This wallet must hold USDC on Arc Testnet (USDC is the native gas token).
ARC_PRIVATE_KEY=0xPASTE_YOUR_ARC_TESTNET_PRIVATE_KEY_HERE

# Arc Testnet RPC endpoint.
ARC_TESTNET_RPC=https://rpc.testnet.arc.io

# USDC ERC-20 on Arc Testnet (6 decimals). This address is canonical.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# -----------------------------------------------------------------------------
# Contract addresses — populated after running Deploy.s.sol
# Paste the addresses printed by the deploy script here.
# VITE_ prefix exposes these to the React frontend at build time.
# -----------------------------------------------------------------------------

VITE_PRICE_ORACLE_ADDRESS=
VITE_SPOT_POOL_ADDRESS=
VITE_PERP_ENGINE_ADDRESS=
VITE_TECHX_ADDRESS=
VITE_ENERGYX_ADDRESS=
VITE_ARCX_ADDRESS=

# Copies without VITE_ prefix — used by Foundry scripts (SeedPools, UpdatePrices)
PRICE_ORACLE_ADDRESS=
SPOT_POOL_ADDRESS=
TECHX_ADDRESS=
ENERGYX_ADDRESS=
ARCX_ADDRESS=

# -----------------------------------------------------------------------------
# Pool seeding amounts (USDC, 6 decimals). Defaults apply if absent.
# Ratio rule: usdcAmount / baseAmount must equal oracle price.
# Default total seed capital: $250 USDC.
#   TECHx  $150 -> 150 USDC : 1 TECHx
#   ENERGYx $75 ->  75 USDC : 1 ENERGYx
#   ARCx    $25 ->  25 USDC : 1 ARCx
# -----------------------------------------------------------------------------

SEED_USDC_TECHX=150000000
SEED_USDC_ENERGYX=75000000
SEED_USDC_ARCX=25000000

# Set to "true" to skip pool seeding in Deploy.s.sol (seed later with SeedPools.s.sol)
SKIP_SEED=false

# -----------------------------------------------------------------------------
# Oracle price updates — used by UpdatePrices.s.sol (8-decimal fixed point)
# Example: $155.50 = 15550000000
# -----------------------------------------------------------------------------

PRICE_TECHX=15000000000
PRICE_ENERGYX=7500000000
PRICE_ARCX=2500000000

# -----------------------------------------------------------------------------
# Block explorer verification (optional)
# Blockscout on Arc Testnet does not require an API key.
# Set to "any" — Foundry needs the field non-empty but ignores the value.
# -----------------------------------------------------------------------------

ETHERSCAN_API_KEY=any

# -----------------------------------------------------------------------------
# Circle / Arc Studio credentials (optional — Circle SDK flows only)
# Set automatically by Arc Studio credential provisioning.
# -----------------------------------------------------------------------------

# CIRCLE_DEVELOPER_CONTROLLED_API_KEY=
# CIRCLE_ENTITY_SECRET=
