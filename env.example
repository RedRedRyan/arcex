# =============================================================================
# arcex — Root environment variables (spot-only stack)
# Copy to .env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Arc RPC endpoints
# -----------------------------------------------------------------------------
ARC_MAINNET_RPC=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC=https://rpc.testnet.arc.io

# -----------------------------------------------------------------------------
# Deployment — required for forge script
# Mainnet deploy gate — must be exactly "yes" to run DeployMainnet.s.sol.
# Leave blank for testnet deploys.
MAINNET_CONFIRM=

# -----------------------------------------------------------------------------
# USDC address (canonical on all Arc chains)
# -----------------------------------------------------------------------------
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# -----------------------------------------------------------------------------
# Deployed addresses — Arc Mainnet (chain 5042), deployed + verified 2026-10-14
# VITE_ prefix exposes the value to the React frontend at build time.
#
# These are the LIVE mainnet deployments. The frontend uses each VITE_ var if
# set, otherwise falls back to the address hardcoded in src/config/addresses.ts
# (which mirrors these). Set a VITE_ var only to repoint the app after a redeploy.
# -----------------------------------------------------------------------------
VITE_TOKEN_FACTORY_ADDRESS=0x29f342baf8b5cce612e4f040d8e1f062a33c175f
VITE_SPOT_POOL_ADDRESS=0x155b7e616cbe9d5972388ec0cd018834ed0f0cdf
VITE_TECHX_ADDRESS=0x7ca6362c602ce7c2547da50d27ca809c95d69c2b
VITE_ENERGYX_ADDRESS=0x7b2c092771cd62cc43728f506b860db35d861192
VITE_ARCX_ADDRESS=0x6affa44ea4dfa689becdcc23e8d8179a967ac352

TOKEN_FACTORY_ADDRESS=0x29f342baf8b5cce612e4f040d8e1f062a33c175f
SPOT_POOL_ADDRESS=0x155b7e616cbe9d5972388ec0cd018834ed0f0cdf
TECHX_ADDRESS=0x7ca6362c602ce7c2547da50d27ca809c95d69c2b
ENERGYX_ADDRESS=0x7b2c092771cd62cc43728f506b860db35d861192
ARCX_ADDRESS=0x6affa44ea4dfa689becdcc23e8d8179a967ac352

TIMELOCK_ADDRESS=
MARKET_REGISTRY_ADDRESS=
PERP_ENGINE_ADDRESS=
PRICE_ORACLE_ADDRESS=

# Pool seeding amounts (USDC, 6 decimals). Ratio: usdcAmt / baseAmt = price.
# Mainnet seed (deployed 2026-10-14): 12 USDC total, 6/4/2 split.
SEED_USDC_TECHX=6000000
SEED_USDC_ENERGYX=4000000
SEED_USDC_ARCX=2000000
SKIP_SEED=false

# Blockscout verification — Blockscout ignores the key value; set to "any"
ETHERSCAN_API_KEY=any

# -----------------------------------------------------------------------------
# Supabase — frontend (publishable key) + indexer (service role)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://lwsiisjjoboeftayirlc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SX10dZOiqBkws8FaxZX6yw_fbelsU95

SUPABASE_URL=https://lwsiisjjoboeftayirlc.supabase.co
# service_role key — server-side only (indexer + cron). NEVER expose as VITE_.
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Indexer / Vercel cron
# -----------------------------------------------------------------------------
INDEXER_START_BLOCK=
CONFIRMATIONS=2
POLL_INTERVAL_MS=3000
LOG_CHUNK_SIZE=2000

# -----------------------------------------------------------------------------
# Circle / Arc Studio credentials (optional — Circle SDK flows only)
# -----------------------------------------------------------------------------
# CIRCLE_DEVELOPER_CONTROLLED_API_KEY=
# CIRCLE_ENTITY_SECRET=
