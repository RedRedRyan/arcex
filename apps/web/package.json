{
  "name": "@arcex/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config ../../vite.config.ts --root ../..",
    "build": "vite build --config ../../vite.config.ts --root ../..",
    "lint": "cd ../.. && oxlint --type-aware src scripts --fix; s=$?; oxlint --fix .; exit $((s>0?s:$?))",
    "typecheck": "cd ../.. && tsc --noEmit",
    "preview": "vite preview --config ../../vite.config.ts --root ../.."
  },
  "dependencies": {
    "@arcex/shared": "workspace:*"
  }
}
